# Configuração central do PostgreSQL. Trocar de servidor exige mudar somente esta URL.
DATABASE_URL=postgresql://nutri_dev:SUA_SENHA_LOCAL@127.0.0.1:5432/nutri_dev
# Proteção contra apontar acidentalmente o desenvolvimento para um banco externo.
# No Docker/servidor, defina como true porque o host do PostgreSQL não será localhost.
NUTRI_ALLOW_REMOTE_DATABASE=false
NUTRI_ENV=development
NUTRI_ALLOW_EMAIL_PREVIEW=true
NUTRI_ALLOW_DEMO_SEED=true
NUTRI_API_PORT=3001

# Reconhecimento por foto. O arquivo contém o mesmo token privado do gateway local.
# O backend acessa o gateway somente em 127.0.0.1:11435 pelo túnel SSH reverso.
NUTRI_VISION_TOKEN_FILE=
# Modo rápido: uma única leitura da IA. Ative apenas se quiser desempate adicional.
NUTRI_VISION_RERANK_ENABLED=false
# Padrões rápidos para OpenAI; podem ser elevados após benchmark de qualidade.
NUTRI_VISION_REASONING_EFFORT=none
NUTRI_VISION_IMAGE_DETAIL=high
# APIs externas podem atender mais de um paciente ao mesmo tempo; Ollama continua em 1.
NUTRI_VISION_MAX_CONCURRENCY=4

# E-mail transacional. No Amazon SES, use as credenciais SMTP da regiao escolhida.
# Links de teste exigem desenvolvimento e NUTRI_ALLOW_EMAIL_PREVIEW=true.
# Em produção, falhas do SES nunca devolvem links de confirmação/restauração.
NUTRI_APP_URL=https://192.168.1.31:3000
NUTRI_SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
NUTRI_SMTP_PORT=587
NUTRI_SMTP_USER=
NUTRI_SMTP_PASSWORD=
NUTRI_EMAIL_FROM=Nutri+ <acesso@seudominio.com.br>
NUTRI_EMAIL_REPLY_TO=contato@seudominio.com.br

# Produção: configurar NUTRI_ENV=production e NUTRI_APP_URL=https://seu-dominio.
# Após provisionar o segredo e a identidade de leitura:
# NUTRI_AWS_SECRET_ID=nutriplus/production/application
# AWS_REGION=sa-east-1
# AWS_PROFILE=nutriplus-app
# O segredo JSON contém DATABASE_URL, NUTRI_SMTP_USER e NUTRI_SMTP_PASSWORD.
# NUTRI_RELEASE recebe o commit publicado durante o deploy.
